# =====================================================================
#  Unreal Engine — .gitignore
#
#  Tracked   : Source/, Config/, Content/, *.uproject, *.uplugin,
#              plugin source & config under Plugins/
#  Ignored   : build output, caches, and generated IDE/project files
# =====================================================================

# --- Build output & caches (project + any plugin/module) -------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/

# Packaging output (keep PakBlacklist + icons used during packaging)
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# --- Generated solution / IDE project files --------------------------
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# --- IDE / editor folders --------------------------------------------
.vs/
.vscode/
.idea/
*.user

# --- Rust (Bevy ECS workspace) build output --------------------------
# Cargo.lock IS committed (this builds a linked cdylib/staticlib artifact),
# and the cbindgen-generated C header IS committed.
/Rust/target/
**/*.rs.bk

# --- Map built-lighting data (regenerated by the editor) -------------
*_BuiltData.uasset

# --- Scratch / throwaway maps (not versioned) ------------------------
# NewMap is a default-named scratch World Partition map. Remove these
# lines (and commit the map) if it ever becomes real, authored content.
/Content/NewMap.umap
/Content/NewMap_*.uasset
/Content/__ExternalActors__/NewMap/
/Content/__ExternalObjects__/NewMap/

# --- Claude Code local (personal) settings ---------------------------
.claude/settings.local.json

# --- Geo bench harness output (screenshots, metrics, flamegraphs) ----
# Generated by `geo-bench` (Rust/crates/tools/logi_bench); date+branch+sha
# foldered runs live here untracked — see Docs/Testing/Geo-Bench.md.
/Bench/

# --- OS cruft --------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
